{
  "name": "jimeh.me",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "PORTLESS_PORT=1355 portless run astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prepare": "husky",
    "precommit": "lint-staged && pnpm check",
    "lint": "eslint . && stylelint 'src/**/*.css' && pnpm lint:markdown",
    "lint:fix": "eslint --fix . && stylelint --fix 'src/**/*.css'",
    "lint:markdown": "markdownlint-cli2",
    "check:content": "tsx scripts/check-content.ts",
    "smoke": "tsx scripts/check-site.ts",
    "optimize:svg": "svgo --config svgo.config.mjs --multipass --folder src --recursive",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "check": "pnpm format:check && pnpm lint && pnpm check:content && pnpm typecheck",
    "verify": "pnpm check && pnpm build && pnpm smoke",
    "import-medium": "tsx scripts/import-medium-posts.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@fancyapps/ui": "^6.1.14",
    "@fontsource-variable/open-sans": "^5.2.7",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "astro-icon": "^1.1.5",
    "rehype-pretty-code": "^0.14.3",
    "remark-github-blockquote-alert": "^2.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/octicon": "^1.2.23",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-mdx": "^3.7.0",
    "fast-xml-parser": "^5.7.3",
    "husky": "^9.1.7",
    "linkedom": "^0.18.12",
    "lint-staged": "^17.0.3",
    "markdownlint-cli2": "^0.22.1",
    "portless": "^0.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "svgo": "^4.0.1",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
