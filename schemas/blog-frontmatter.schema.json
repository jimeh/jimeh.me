{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimeh.me/schemas/blog-frontmatter.schema.json",
  "title": "jimeh.me Blog Frontmatter",
  "description": "Frontmatter schema for posts in src/content/blog.",
  "$comment": "Generated by scripts/generate-blog-frontmatter-schema.ts; do not edit.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Post title."
    },
    "description": {
      "type": "string",
      "description": "Short summary for listings and metadata."
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Date in YYYY-MM-DD format."
    },
    "updatedDate": {
      "description": "Later revision date; must not be earlier than date.",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "tags": {
      "description": "Blog tag slugs.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Lowercase slug string."
      }
    },
    "archive": {
      "description": "Archive marker, or archive source name.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "image": {
      "description": "Primary image rendered above the post unless hidden.",
      "type": "object",
      "properties": {
        "src": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Local relative path or supported remote HTTPS image."
            },
            {
              "type": "object",
              "properties": {
                "light": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Local relative path or supported remote HTTPS image."
                },
                "dark": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Local relative path or supported remote HTTPS image."
                }
              },
              "required": ["light"],
              "additionalProperties": false
            }
          ],
          "description": "Local relative image, remote HTTPS image, or light/dark sources."
        },
        "alt": {
          "default": "",
          "description": "Accessible text; empty string is allowed.",
          "type": "string"
        },
        "caption": {
          "description": "Visible caption.",
          "type": "string"
        },
        "size": {
          "default": "default",
          "description": "Rendered image width.",
          "anyOf": [
            {
              "type": "string",
              "enum": ["default", "wide", "full"]
            },
            {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?%$",
              "description": "Percentage value like '90%'."
            }
          ]
        },
        "position": {
          "default": "center",
          "description": "Image alignment or float position.",
          "type": "string",
          "enum": ["center", "left", "right"]
        },
        "flush": {
          "description": "Remove top margin so the image sits flush with content.",
          "type": "boolean"
        },
        "noLightbox": {
          "description": "Disable the Fancybox lightbox for this image.",
          "type": "boolean"
        },
        "gallery": {
          "description": "Lightbox gallery group name.",
          "type": "string"
        },
        "aspect": {
          "description": "CSS aspect-ratio for the displayed image box.",
          "type": "string"
        },
        "objectPosition": {
          "default": "center",
          "description": "CSS object-position when aspect is set.",
          "type": "string"
        },
        "credit": {
          "description": "Attribution / credit line shown below the caption.",
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "Attribution text."
            },
            "href": {
              "description": "Attribution URL.",
              "type": "string",
              "format": "uri"
            },
            "position": {
              "default": "center",
              "description": "Credit line alignment.",
              "type": "string",
              "enum": ["left", "center", "right"]
            }
          },
          "required": ["text"],
          "additionalProperties": false
        },
        "hidden": {
          "default": false,
          "description": "Hide from automatic rendering at the top of the post.",
          "type": "boolean"
        },
        "thumbnail": {
          "description": "Listing thumbnail controls.",
          "type": "object",
          "properties": {
            "src": {
              "description": "Thumbnail-specific source; defaults to image.src.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Local relative path or supported remote HTTPS image."
                },
                {
                  "type": "object",
                  "properties": {
                    "light": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Local relative path or supported remote HTTPS image."
                    },
                    "dark": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Local relative path or supported remote HTTPS image."
                    }
                  },
                  "required": ["light"],
                  "additionalProperties": false
                }
              ]
            },
            "fill": {
              "default": "fill",
              "description": "How the thumbnail fills the thumbnail container.",
              "type": "string",
              "enum": ["fill", "fit"]
            },
            "objectPosition": {
              "description": "CSS object-position for cropped thumbnail images.",
              "type": "string"
            },
            "frame": {
              "description": "Draw the thumbnail inside a bordered background.",
              "type": "boolean"
            },
            "size": {
              "default": "100%",
              "description": "Image size within thumbnail boxes.",
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?%$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["src"],
      "additionalProperties": false
    }
  },
  "required": ["title", "description", "date"],
  "additionalProperties": false
}
