---
import { siteConfig } from "../data/site";

interface Props {
  /** Page title (falls back to siteConfig.title). */
  title?: string;
  /** Page description (falls back to siteConfig.description). */
  description?: string;
  /** Open Graph type: "website" (default) or "article". */
  ogType?: "website" | "article";
  /** ISO date string for article:published_time. */
  publishedTime?: string;
  /** ISO date string for article:modified_time. */
  modifiedTime?: string;
  /** Article tags for meta keywords. */
  tags?: string[];
  /** Absolute URL for og:image / twitter:image. */
  ogImage?: string;
  /** Alternate representations of the current page. */
  alternateLinks?: AlternateLink[];
}

export interface AlternateLink {
  /** URL for the alternate representation. */
  href: string;
  /** Media type for the alternate representation. */
  type: string;
  /** Human-readable label for the alternate representation. */
  title?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags,
  ogImage,
  alternateLinks = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);

const jsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        url: canonicalURL.href,
        datePublished: publishedTime,
        dateModified: modifiedTime || publishedTime,
        author: {
          "@type": "Person",
          name: siteConfig.social.name,
          url: siteConfig.url,
        },
        keywords: tags?.join(", "),
        ...(ogImage && { image: ogImage }),
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteConfig.title,
        description: siteConfig.description,
        url: siteConfig.url,
        author: {
          "@type": "Person",
          name: siteConfig.social.name,
          url: siteConfig.url,
          sameAs: siteConfig.social.links,
        },
      };
---

<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL.href} />
{
  alternateLinks.map((link) => (
    <link
      rel="alternate"
      type={link.type}
      title={link.title}
      href={link.href}
    />
  ))
}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
{ogImage && <meta property="og:image" content={ogImage} />}

{
  ogType === "article" && (
    <>
      {publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )}
      {modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )}
      <meta property="article:author" content={siteConfig.social.name} />
      {tags?.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter Card -->
<meta
  name="twitter:card"
  content={ogImage ? "summary_large_image" : "summary"}
/>
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!-- JSON-LD -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>
