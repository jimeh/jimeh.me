---
import Figure from "./Figure.astro";

interface Props {
  columns?: number;
  gap?: string;
  size?: "default" | "wide" | "full" | (string & {});
  caption?: string;
  /** Lightbox gallery group name applied to all child Figure elements. */
  gallery?: string;
}

const {
  columns = 2,
  gap = "1rem",
  size = "default",
  caption,
  gallery,
} = Astro.props;

const isPercentage = /^\d+%$/.test(size);

const figureClasses = ["blog-image-grid", isPercentage && "mx-auto"]
  .filter(Boolean)
  .join(" ");

const gridStyle = [`--grid-columns: ${columns}`, `gap: ${gap}`].join("; ");
---

<Figure class={figureClasses} size={size} caption={caption}>
  <div class="blog-image-grid-inner" style={gridStyle} data-gallery={gallery}>
    <slot />
  </div>
  {
    Astro.slots.has("caption") && (
      <Fragment slot="caption">
        <slot name="caption" />
      </Fragment>
    )
  }
</Figure>
