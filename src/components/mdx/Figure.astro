---
import Credit from "./Credit.astro";
import "./Figure.css";

interface Props {
  size?: "default" | "wide" | "full" | (string & {});
  position?: "center" | "left" | "right";
  /** Remove block margins so the figure sits flush with surrounding content. */
  flush?: boolean;
  caption?: string;
  /** Attribution / credit line shown below the caption. */
  credit?: {
    text: string;
    href?: string;
    position?: "left" | "center" | "right";
  };
  class?: string;
}

const {
  size = "default",
  position = "center",
  flush = position === "left" || position === "right",
  caption,
  credit,
} = Astro.props;

const isPercentage = /^\d+%$/.test(size);

const sizeClass = isPercentage
  ? ""
  : {
      default: "",
      wide: "mdx-figure-wide",
      full: "mdx-figure-full",
    }[size as "default" | "wide" | "full"];

const positionClasses = isPercentage
  ? {
      center: "mx-auto",
      left: "float-left mr-6 mb-2",
      right: "float-right ml-6 mb-2",
    }[position]
  : "";

const figureStyle = isPercentage ? `width: ${size}` : undefined;

/* Render caption slot eagerly so we can check whether it produced
   any actual content.  Astro registers named slots at compile time,
   so `Astro.slots.has("caption")` may return true even when the slot
   was conditionally omitted at runtime. */
const captionHtml = Astro.slots.has("caption")
  ? await Astro.slots.render("caption")
  : null;
const hasCaptionSlot = !!captionHtml?.trim();
---

<figure
  class:list={[
    Astro.props.class,
    sizeClass,
    positionClasses,
    flush && "mdx-figure-flush",
  ]}
  style={figureStyle}
>
  <slot />
  {
    (hasCaptionSlot || caption || credit) && (
      <figcaption class="text-muted mt-2 text-center text-sm">
        {hasCaptionSlot ? <Fragment set:html={captionHtml} /> : caption}
        {credit && (
          <Credit
            text={credit.text}
            href={credit.href}
            position={credit.position}
            class={hasCaptionSlot || caption ? "mt-1" : undefined}
          />
        )}
      </figcaption>
    )
  }
</figure>
