---
import Credit from "./Credit.astro";
import "./Figure.css";

interface Props {
  size?: "default" | "wide" | "full" | (string & {});
  position?: "center" | "left" | "right";
  /** Percentage of the figure width that hangs outside a left/right float. */
  overhang?: `${number}%` | "outside";
  /** Remove block margins so the figure sits flush with surrounding content. */
  flush?: boolean;
  caption?: string;
  /** Attribution / credit line shown below the caption. */
  credit?: {
    text: string;
    href?: string;
    position?: "left" | "center" | "right";
  };
  class?: string;
}

const {
  size = "default",
  position = "center",
  overhang,
  flush = position === "left" || position === "right",
  caption,
  credit,
} = Astro.props;

const sizeMatch = size.match(/^(\d+(?:\.\d+)?)%$/);
const isPercentage = !!sizeMatch;
const sizePercent = sizeMatch ? Number.parseFloat(sizeMatch[1]) : 0;
const isOversizeCentered =
  isPercentage && sizePercent > 100 && position === "center";
const overhangMatch =
  overhang === "outside" ? null : overhang?.match(/^(\d+(?:\.\d+)?)%$/);
const overhangRatio =
  overhang === "outside"
    ? 1
    : overhangMatch
      ? Number.parseFloat(overhangMatch[1]) / 100
      : 0;
const hasOverhang =
  isPercentage &&
  overhangRatio > 0 &&
  (position === "left" || position === "right");
const hangsOutside = overhang === "outside" || overhangRatio >= 1;

const sizeClass = isPercentage
  ? ""
  : {
      default: "",
      wide: "mdx-figure-wide",
      full: "mdx-figure-full",
    }[size as "default" | "wide" | "full"];

const positionClasses = isPercentage
  ? {
      center: isOversizeCentered ? "mdx-figure-oversize" : "mx-auto",
      left: "mdx-figure-float-left",
      right: "mdx-figure-float-right",
    }[position]
  : "";

const figureStyle = [
  isOversizeCentered
    ? `--mdx-figure-width: min(${size}, calc(100vw - 3rem))`
    : isPercentage && `width: ${size}`,
  hasOverhang &&
    `--mdx-figure-overhang: calc(-${sizePercent * overhangRatio}%${
      hangsOutside ? " - var(--mdx-figure-float-gutter)" : ""
    })`,
]
  .filter(Boolean)
  .join("; ");

/* Render caption slot eagerly so we can check whether it produced
   any actual content.  Astro registers named slots at compile time,
   so `Astro.slots.has("caption")` may return true even when the slot
   was conditionally omitted at runtime. */
const captionHtml = Astro.slots.has("caption")
  ? await Astro.slots.render("caption")
  : null;
const hasCaptionSlot = !!captionHtml?.trim();
---

<figure
  class:list={[
    Astro.props.class,
    sizeClass,
    positionClasses,
    flush && "mdx-figure-flush",
  ]}
  style={figureStyle || undefined}
>
  <slot />
  {
    (hasCaptionSlot || caption || credit) && (
      <figcaption class="text-muted mt-2 text-center text-sm">
        {hasCaptionSlot ? <Fragment set:html={captionHtml} /> : caption}
        {credit && (
          <Credit
            text={credit.text}
            href={credit.href}
            position={credit.position}
            class={hasCaptionSlot || caption ? "mt-1" : undefined}
          />
        )}
      </figcaption>
    )
  }
</figure>
