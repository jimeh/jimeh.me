---
import { Image as AstroImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Figure from "./Figure.astro";
import "./Image.css";

interface Props {
  src: ImageMetadata | string;
  darkSrc?: ImageMetadata | string;
  alt?: string;
  caption?: string;
  /** Attribution / credit line shown below the caption. */
  credit?: {
    text: string;
    href?: string;
    position?: "left" | "center" | "right";
  };
  size?: "default" | "wide" | "full" | (string & {});
  position?: "center" | "left" | "right";
  /** Percentage of the image width that hangs outside a left/right float. */
  overhang?: `${number}%` | "outside";
  /** CSS aspect-ratio for the displayed image box (e.g. "16/9"). */
  aspect?: string;
  /** CSS object-position when aspect is set (e.g. "top", "center"). */
  objectPosition?: string;
  /** Intrinsic width for remote or public string image sources. */
  width?: number | `${number}`;
  /** Intrinsic height for remote or public string image sources. */
  height?: number | `${number}`;
  /** Remove block margins so the figure sits flush with surrounding content. */
  flush?: boolean;
  /** Lightbox gallery group name. Images sharing the same gallery form a set. */
  gallery?: string;
  /** Disable the Fancybox lightbox for this image. */
  noLightbox?: boolean;
  /** Browser image loading behavior. */
  loading?: "eager" | "lazy";
}

const {
  src,
  darkSrc,
  caption,
  credit,
  size = "default",
  position = "center",
  overhang,
  aspect,
  objectPosition = "center",
  width,
  height,
  flush,
  gallery = "gallery",
  noLightbox = false,
  loading = "lazy",
} = Astro.props;

const alt = Astro.props.alt ?? caption ?? "";
const hasWidth = width !== undefined;
const hasHeight = height !== undefined;
const hasExplicitDimensions = hasWidth && hasHeight;
const isStringSource = typeof src === "string";
const isRemoteSource = isStringSource && /^https?:\/\//i.test(src);
const isSvgSource = !isStringSource && src.format === "svg";
const hasDarkSvg =
  isSvgSource &&
  darkSrc !== undefined &&
  typeof darkSrc !== "string" &&
  darkSrc.format === "svg";
const imageHref = isStringSource ? src : src.src;

if (hasWidth !== hasHeight) {
  throw new Error("Image width and height must be provided together.");
}

if (isStringSource && !isRemoteSource && !hasExplicitDimensions) {
  throw new Error("String image sources must provide width and height.");
}

const astroImageProps = isStringSource
  ? hasExplicitDimensions
    ? { src, width, height }
    : { src, inferSize: true as const }
  : { src };

const isPercentage = /^\d+(?:\.\d+)?%$/.test(size);

const imgClasses = isPercentage
  ? "block"
  : `block ${
      {
        center: "mx-auto",
        left: "mr-auto",
        right: "ml-auto",
      }[position]
    }`;

const sizes = isPercentage
  ? `(min-width: 672px) ${size}, 100vw`
  : size === "full"
    ? "100vw"
    : size === "wide"
      ? "(min-width: 960px) 960px, 100vw"
      : "(min-width: 672px) 672px, 100vw";

const imgStyle = aspect
  ? `aspect-ratio: ${aspect}; object-position: ${objectPosition}`
  : undefined;

// Figure.css owns spacing/caption layout for this component, so opt its image
// out of Tailwind Typography's generic `.prose img` margins.
const proseOptOutClass = "not-prose";
---

<Figure
  class="mdx-figure"
  size={size}
  position={position}
  overhang={overhang}
  flush={flush}
  caption={caption}
  credit={credit}
>
  {
    noLightbox ? (
      isSvgSource ? (
        <>
          <img
            src={src.src}
            alt={alt}
            class:list={[
              proseOptOutClass,
              imgClasses,
              aspect && "object-cover",
              hasDarkSvg && "dark:hidden",
            ]}
            style={imgStyle}
            width={src.width}
            height={src.height}
            loading={loading}
          />
          {hasDarkSvg && (
            <img
              src={darkSrc.src}
              alt={alt}
              class:list={[
                proseOptOutClass,
                imgClasses,
                aspect && "object-cover",
                "hidden dark:block",
              ]}
              style={imgStyle}
              width={darkSrc.width}
              height={darkSrc.height}
              loading={loading}
            />
          )}
        </>
      ) : (
        <AstroImage
          {...astroImageProps}
          alt={alt}
          class:list={[proseOptOutClass, imgClasses, aspect && "object-cover"]}
          style={imgStyle}
          widths={[640, 960, 1280, 1600]}
          sizes={sizes}
          loading={loading}
        />
      )
    ) : (
      <a
        href={imageHref}
        data-fancybox={gallery}
        data-caption={caption}
        class="mdx-fancybox-link"
      >
        {isSvgSource ? (
          <>
            <img
              src={src.src}
              alt={alt}
              class:list={[
                proseOptOutClass,
                imgClasses,
                aspect && "object-cover",
                hasDarkSvg && "dark:hidden",
              ]}
              style={imgStyle}
              width={src.width}
              height={src.height}
              loading={loading}
            />
            {hasDarkSvg && (
              <img
                src={darkSrc.src}
                alt={alt}
                class:list={[
                  proseOptOutClass,
                  imgClasses,
                  aspect && "object-cover",
                  "hidden dark:block",
                ]}
                style={imgStyle}
                width={darkSrc.width}
                height={darkSrc.height}
                loading={loading}
              />
            )}
          </>
        ) : (
          <AstroImage
            {...astroImageProps}
            alt={alt}
            class:list={[
              proseOptOutClass,
              imgClasses,
              aspect && "object-cover",
            ]}
            style={imgStyle}
            widths={[640, 960, 1280, 1600]}
            sizes={sizes}
            loading={loading}
          />
        )}
      </a>
    )
  }
  {
    Astro.slots.has("default") && (
      <Fragment slot="caption">
        <slot />
      </Fragment>
    )
  }
</Figure>
