---
import { Icon } from "astro-icon/components";
import Tooltip from "./ui/Tooltip.astro";

const tooltipId = `theme-toggle-tooltip-${crypto.randomUUID()}`;
---

<Tooltip id={tooltipId}>
  <button
    slot="trigger"
    data-theme-toggle
    type="button"
    class="text-muted hover:text-accent cursor-pointer rounded-full p-2"
    aria-label="Toggle theme"
    aria-describedby={tooltipId}
  >
    <Icon name="sun-moon" data-theme-icon="system" class="hidden size-5" />
    <Icon name="heroicons:sun" data-theme-icon="light" class="hidden size-5" />
    <Icon name="heroicons:moon" data-theme-icon="dark" class="hidden size-5" />
  </button>
  <span data-tooltip-text="system" class="hidden">System</span>
  <span data-tooltip-text="light" class="hidden">Light</span>
  <span data-tooltip-text="dark" class="hidden">Dark</span>
</Tooltip>

<script>
  import { initThemeToggle } from "./theme-toggle";

  function init() {
    initThemeToggle(document, window, localStorage);
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
</script>
