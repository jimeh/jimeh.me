---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";
import { readingTime } from "@utils/reading-time";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, date, tags, image } = post.data;
const readTime = readingTime(post.body ?? "");

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + "T00:00:00");
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<article class="group">
  <div class:list={["flex gap-4", image && "sm:gap-5"]}>
    {
      image && (
        <a
          href={`/blog/${post.id}/`}
          class="hidden shrink-0 sm:block"
          aria-hidden="true"
          tabindex="-1"
        >
          <Image
            src={image.src}
            alt={image.alt}
            class="aspect-[3/2] w-40 rounded object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            widths={[160, 320]}
            sizes="160px"
          />
        </a>
      )
    }
    <div class="min-w-0 flex-1">
      <a href={`/blog/${post.id}/`} class="block">
        <h3
          class="text-heading group-hover:text-accent text-lg leading-snug font-bold [font-stretch:75%] transition-colors"
        >
          {title}
        </h3>
      </a>
      <p class="text-subheading mt-1.5 text-sm leading-relaxed">
        {description}
      </p>
      <div class="text-muted mt-1 flex items-center gap-2 text-sm">
        <time datetime={date}>{formatDate(date)}</time>
        <span>&middot;</span>
        <span>{readTime} min read</span>
      </div>
      {
        tags && tags.length > 0 && (
          <div class="mt-2">
            <TagList tags={tags} />
          </div>
        )
      }
    </div>
  </div>
</article>
