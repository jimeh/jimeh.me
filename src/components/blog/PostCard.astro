---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { blogPostUrl } from "@utils/blog-url";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, date, image } = post.data;
const href = blogPostUrl(post);

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + "T00:00:00");
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<article class="group">
  <div class:list={["flex gap-4", image && "sm:gap-5"]}>
    {
      image && (
        <a
          href={href}
          class="hidden shrink-0 sm:block"
          aria-hidden="true"
          tabindex="-1"
        >
          <Image
            src={image.src}
            alt={image.alt}
            class:list={[
              "aspect-[3/2] w-40 rounded transition-transform duration-300 group-hover:scale-[1.02]",
              image.thumbnailFill === "full"
                ? "object-contain"
                : "object-cover",
            ]}
            style={`object-position: ${image.objectPosition}`}
            widths={[160, 320]}
            sizes="160px"
          />
        </a>
      )
    }
    <div class="min-w-0 flex-1">
      <a href={href} class="block">
        <h3
          class="text-heading group-hover:text-accent text-lg leading-snug font-bold [font-stretch:75%] transition-colors"
        >
          {title}
        </h3>
      </a>
      <p class="text-subheading mt-1.5 line-clamp-2 text-sm leading-relaxed">
        {description}
      </p>
      <div class="text-muted mt-1 text-sm">
        <time datetime={date}>{formatDate(date)}</time>
      </div>
    </div>
  </div>
</article>
