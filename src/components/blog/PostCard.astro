---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { blogPostUrl } from "@utils/blog-url";

interface Props {
  post: CollectionEntry<"blog">;
  imageLoading?: "eager" | "lazy";
}

const { post, imageLoading = "lazy" } = Astro.props;
const { title, description, date, image } = post.data;
const href = blogPostUrl(post);
const linkLabel = `Read "${title}"`;

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + "T00:00:00");
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<article class="group">
  <div class="flex gap-4 sm:gap-5">
    {
      image ? (
        <a
          href={href}
          class="hidden shrink-0 sm:block"
          aria-label={linkLabel}
          tabindex="-1"
        >
          <Image
            src={image.src}
            alt=""
            class:list={[
              "aspect-[3/2] w-40 rounded transition-transform duration-300 group-hover:scale-[1.02]",
              image.thumbnailFill === "full"
                ? "object-contain"
                : "object-cover",
            ]}
            style={`object-position: ${image.objectPosition}`}
            widths={[160, 320]}
            sizes="160px"
            loading={imageLoading}
          />
        </a>
      ) : (
        <a
          href={href}
          class="bg-surface-subtle border-border text-muted group-hover:text-accent hidden aspect-[3/2] w-40 shrink-0 place-items-center rounded border transition-colors duration-300 sm:grid"
          aria-label={linkLabel}
          tabindex="-1"
        >
          <Icon
            name="fa6-solid:newspaper"
            class="size-9 opacity-55"
            aria-hidden="true"
          />
        </a>
      )
    }
    <div class="min-w-0 flex-1">
      <a href={href} class="block">
        <h3
          class="text-heading group-hover:text-accent text-lg leading-snug font-bold [font-stretch:75%] transition-colors"
        >
          {title}
        </h3>
      </a>
      <p class="text-subheading mt-1.5 line-clamp-2 text-sm leading-relaxed">
        {description}
      </p>
      <div class="text-muted mt-1 text-sm">
        <time datetime={date}>{formatDate(date)}</time>
      </div>
    </div>
  </div>
</article>
