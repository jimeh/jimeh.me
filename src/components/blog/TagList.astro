---
interface Props {
  tags: string[];
  /** Render as links (default) or plain text. */
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
---

<div class="flex flex-wrap gap-2" role="list" aria-label="Tags">
  {
    tags.map((tag) =>
      linked ? (
        <a
          href={`/blog/tags/${tag}/`}
          class="text-muted hover:text-accent border-border hover:border-accent rounded-full border px-3.5 py-1.5 text-sm transition-colors"
          role="listitem"
        >
          {tag}
        </a>
      ) : (
        <span
          class="text-muted border-border rounded-full border px-3.5 py-1.5 text-sm"
          role="listitem"
        >
          {tag}
        </span>
      ),
    )
  }
</div>
