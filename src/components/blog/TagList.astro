---
interface Props {
  tags: string[];
  /** Render as links (default) or plain text. */
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label="Tags">
  {
    tags.map((tag) =>
      linked ? (
        <li>
          <a
            href={`/blog/tags/${tag}/`}
            class="text-muted hover:text-accent border-border hover:border-accent block rounded-full border px-3.5 py-1.5 text-sm transition-colors"
          >
            {tag}
          </a>
        </li>
      ) : (
        <li>
          <span class="text-muted border-border block rounded-full border px-3.5 py-1.5 text-sm">
            {tag}
          </span>
        </li>
      ),
    )
  }
</ul>
