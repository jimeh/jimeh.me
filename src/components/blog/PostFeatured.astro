---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { blogPostUrl } from "@utils/blog-url";
import { readingTime } from "@utils/reading-time";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, date, image } = post.data;
const readTime = readingTime(post.body ?? "");
const href = blogPostUrl(post);

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + "T00:00:00");
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<article class="group">
  <a href={href} class="block">
    {
      image && (
        <div class="overflow-hidden rounded-lg transition-transform duration-300 group-hover:scale-[1.015]">
          <Image
            src={image.src}
            alt={image.alt}
            class:list={[
              "aspect-[2/1] w-full transition-transform duration-300 group-hover:scale-[1.015]",
              image.thumbnailFill === "full"
                ? "object-contain"
                : "object-cover",
            ]}
            style={`object-position: ${image.objectPosition}`}
            widths={[640, 960, 1440, 1920]}
            sizes="(min-width: 1008px) 960px, calc(100vw - 3rem)"
          />
        </div>
      )
    }
    <div class={image ? "mt-4" : ""}>
      <h3
        class="text-heading group-hover:text-accent text-xl leading-snug font-bold [font-stretch:75%] transition-colors sm:text-2xl"
      >
        {title}
      </h3>
      <p
        class="text-subheading mt-2 text-sm leading-relaxed sm:text-base sm:leading-relaxed"
      >
        {description}
      </p>
      <div class="text-muted mt-2 flex items-center gap-2 text-sm">
        <time datetime={date}>{formatDate(date)}</time>
        <span>&middot;</span>
        <span>{readTime} min read</span>
      </div>
    </div>
  </a>
</article>
