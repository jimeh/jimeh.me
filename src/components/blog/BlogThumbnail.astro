---
import { Icon } from "astro-icon/components";
import AssetImage from "@components/ui/AssetImage.astro";
import type { ImageSource } from "@utils/image-source";
import { darkImage, lightImage } from "@utils/image-source";
import { resolveThumbnailFrame } from "@utils/thumbnail-frame";
import type { ThumbnailFrame } from "@utils/thumbnail-frame";
import {
  scaledPixelSize,
  scaledResponsiveSize,
  scaledThumbnailWidths,
} from "@utils/thumbnail-size";

type Variant = "card" | "featured";

interface Props {
  alt?: string;
  href: string;
  label: string;
  loading?: "eager" | "lazy";
  objectPosition?: string;
  source?: ImageSource;
  thumbnail?: {
    fill: "fill" | "fit";
    frame?: ThumbnailFrame;
    size: string;
  };
  variant?: Variant;
}

const {
  alt = "",
  href,
  label,
  loading = "lazy",
  objectPosition = "center",
  source,
  thumbnail,
  variant = "card",
} = Astro.props;

const light = source ? lightImage(source) : undefined;
const dark = source ? darkImage(source) : undefined;
const size = thumbnail?.size ?? "100%";
const fitClass = thumbnail?.fill === "fit" ? "object-contain" : "object-cover";
const imageStyle = light
  ? `height: ${size}; object-position: ${objectPosition}; width: ${size}`
  : undefined;

const isCard = variant === "card";
const widths = light
  ? scaledThumbnailWidths(
      isCard ? [160, 320] : [640, 960, 1440, 1920],
      size,
      light.width,
    )
  : undefined;
const sizes = isCard
  ? scaledPixelSize(160, size)
  : scaledResponsiveSize(960, 100, 3, size);
const frame = resolveThumbnailFrame(
  light === undefined ? true : thumbnail?.frame,
);
const frameClasses = [
  frame.light && "bg-surface-subtle border-border border",
  frame.dark && "dark:bg-surface-subtle dark:border-border dark:border",
  frame.light && !frame.dark && "dark:bg-transparent dark:border-0",
];
const cardFrameClasses = [
  frame.light && "text-muted group-hover:text-accent",
  frame.dark && "dark:text-muted dark:group-hover:text-accent",
  ...frameClasses,
];
const boxClasses = isCard
  ? [
      "group-hover:scale-[1.02] relative hidden aspect-[3/2] w-40 shrink-0 self-start overflow-hidden rounded transition duration-300",
      frame.any ? ["place-items-center sm:grid", cardFrameClasses] : "sm:block",
    ]
  : [
      "relative aspect-[2/1] overflow-hidden rounded-lg transition-transform duration-300 group-hover:scale-[1.015]",
      frameClasses,
    ];
const imageClasses = [
  "absolute top-1/2 left-1/2 max-w-none -translate-x-1/2 -translate-y-1/2",
  fitClass,
];
---

{
  isCard ? (
    <a href={href} class:list={boxClasses} aria-label={label} tabindex="-1">
      {light ? (
        <>
          <AssetImage
            src={light}
            alt={alt}
            classList={[imageClasses, dark && "dark:hidden"]}
            style={imageStyle}
            widths={widths}
            sizes={sizes}
            loading={loading}
          />
          {dark && (
            <AssetImage
              src={dark}
              alt={alt}
              classList={[imageClasses, "hidden dark:block"]}
              style={imageStyle}
              widths={widths}
              sizes={sizes}
              loading={loading}
            />
          )}
        </>
      ) : (
        <Icon
          name="fa6-solid:newspaper"
          class="size-9 opacity-55"
          aria-hidden="true"
        />
      )}
    </a>
  ) : (
    light && (
      <div class:list={boxClasses}>
        <AssetImage
          src={light}
          alt={alt}
          classList={[imageClasses, dark && "dark:hidden"]}
          style={imageStyle}
          widths={widths}
          sizes={sizes}
          loading={loading}
          fetchpriority="high"
        />
        {dark && (
          <AssetImage
            src={dark}
            alt={alt}
            classList={[imageClasses, "hidden dark:block"]}
            style={imageStyle}
            widths={widths}
            sizes={sizes}
            loading={loading}
            fetchpriority="high"
          />
        )}
      </div>
    )
  )
}
