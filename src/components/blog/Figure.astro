---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
  size?: "default" | "wide" | "full" | (string & {});
  position?: "center" | "left" | "right";
  /** Remove block margins so the figure sits flush with surrounding content. */
  flush?: boolean;
}

const {
  src,
  caption,
  size = "default",
  position = "center",
  flush = false,
} = Astro.props;

const alt = Astro.props.alt ?? caption ?? "";

const isPercentage = /^\d+%$/.test(size);

const sizeClass = isPercentage
  ? ""
  : {
      default: "",
      wide: "blog-image-wide",
      full: "blog-image-full",
    }[size as "default" | "wide" | "full"];

const figureClasses = isPercentage
  ? {
      center: "mx-auto",
      left: "float-left mr-6 mb-2",
      right: "float-right ml-6 mb-2",
    }[position]
  : "";

const imgClasses = isPercentage
  ? "block"
  : `block ${
      {
        center: "mx-auto",
        left: "mr-auto",
        right: "ml-auto",
      }[position]
    }`;

const figureStyle = isPercentage ? `width: ${size}` : undefined;

const sizes = isPercentage
  ? `(min-width: 672px) ${size}, 100vw`
  : size === "full"
    ? "100vw"
    : size === "wide"
      ? "(min-width: 960px) 960px, 100vw"
      : "(min-width: 672px) 672px, 100vw";
---

<figure
  class:list={["blog-figure", sizeClass, figureClasses, flush && "blog-figure-flush"]}
  style={figureStyle}
>
  <Image
    src={src}
    alt={alt}
    class:list={[imgClasses]}
    widths={[640, 960, 1280, 1600]}
    sizes={sizes}
  />
  {
    caption && (
      <figcaption class="text-muted mt-2 text-center text-sm">
        {caption}
      </figcaption>
    )
  }
</figure>
