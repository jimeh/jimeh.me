---
interface Props {
  date: string;
  updatedDate?: string;
  readingTime: number;
  archiveLabel?: string;
  archiveHref?: string;
}

const { date, updatedDate, readingTime, archiveLabel, archiveHref } =
  Astro.props;

function formatDate(dateStr: string): string {
  const d = new Date(dateStr + "T00:00:00");
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<div class="text-muted flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
  <time datetime={date}>{formatDate(date)}</time>
  {
    updatedDate && (
      <>
        <span>&middot;</span>
        <span>
          updated <time datetime={updatedDate}>{formatDate(updatedDate)}</time>
        </span>
      </>
    )
  }
  <span>&middot;</span>
  <span
    aria-label={`${readingTime} minute${readingTime === 1 ? "" : "s"} read`}
  >
    {readingTime} min read
  </span>
  {
    archiveLabel && archiveHref && (
      <>
        <span>&middot;</span>
        <a href={archiveHref} class="hover:text-accent transition-colors">
          {archiveLabel}
        </a>
      </>
    )
  }
</div>
