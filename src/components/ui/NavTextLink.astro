---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "text-heading hover:text-accent text-base font-bold tracking-wide uppercase",
    "[font-stretch:75%] transition-colors",
    className,
  ]}
>
  <slot />
</a>
