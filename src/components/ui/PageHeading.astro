---
interface Props {
  as?: "h1" | "h2";
  size?: "page" | "section" | "post";
  uppercase?: boolean;
  class?: string;
}

const {
  as = "h1",
  size: propSize,
  uppercase = false,
  class: className,
}: Props = Astro.props;

const size = propSize ?? (as === "h2" ? "section" : "page");
const Tag = as;
const sizeClassMap = {
  page: "text-4xl sm:text-5xl",
  section: "text-2xl",
  post: "text-3xl leading-tight sm:text-4xl",
};
const sizeClass = sizeClassMap[size];
---

<Tag
  class:list={[
    "text-heading font-bold [font-stretch:75%]",
    sizeClass,
    uppercase && "uppercase",
    className,
  ]}
>
  <slot />
</Tag>
