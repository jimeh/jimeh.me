---
import { getCollection } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import PostCard from "@components/blog/PostCard.astro";
import MetaText from "@components/ui/MetaText.astro";
import PageHeading from "@components/ui/PageHeading.astro";
import { archivePageData, archiveStaticPaths } from "@utils/blog-page-data";
import { blogArchiveUrl, blogArchivesUrl, blogIndexUrl } from "@utils/blog-url";

interface Props {
  label: string;
  slug: string;
}

export async function getStaticPaths() {
  return archiveStaticPaths(await getCollection("blog"));
}

const { label, slug } = Astro.props;
const breadcrumbs = [
  { href: "/", label: "jimeh" },
  { href: blogIndexUrl(), label: "Blog" },
  { href: blogArchivesUrl(), label: "Archives" },
  { href: blogArchiveUrl(slug), label },
];
const { posts, postsByYear, yearRange, years } = archivePageData(
  await getCollection("blog"),
  slug,
);
---

<BlogLayout
  title={`Archive: ${label} - Blog - Jim Myhrberg`}
  description={`Archived ${label} blog posts by Jim Myhrberg`}
  breadcrumbs={breadcrumbs}
>
  <PageHeading as="h1" size="page" uppercase>Archive: {label}</PageHeading>
  <MetaText>
    {posts.length}{" "}
    {posts.length === 1 ? "post" : "posts"}
    {" · "}
    {yearRange}
    &middot;
    <a href={blogArchivesUrl()} class="text-accent hover:underline">
      all archives
    </a>
  </MetaText>

  {
    years.map((year) => (
      <section class="mt-12">
        <PageHeading as="h2" size="section" class="text-muted mb-6 opacity-75">
          {year}
        </PageHeading>
        <div class="space-y-6">
          {postsByYear.get(year)!.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    ))
  }
</BlogLayout>
