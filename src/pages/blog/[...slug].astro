---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { Image } from "@mdx/index";
import PostPagerLink from "@components/blog/PostPagerLink.astro";
import PostMeta from "@components/blog/PostMeta.astro";
import TagList from "@components/blog/TagList.astro";
import CodeCopyButton from "@components/blog/CodeCopyButton.astro";
import FancyboxInit from "@components/blog/FancyboxInit.astro";
import PageHeading from "@components/ui/PageHeading.astro";
import { compareBlogPostsAsc } from "@utils/blog-sort";
import { readingTime } from "@utils/reading-time";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, date, updatedDate, tags, image } = post.data;
const readTime = readingTime(post.body ?? "");
const { Content } = await render(post);

// Resolve absolute URL for OG/Twitter image meta tags.
let ogImageUrl: string | undefined;
if (image) {
  const optimized = await getImage({
    src: image.src,
    width: 1200,
    format: "jpg",
  });
  ogImageUrl = new URL(optimized.src, Astro.site).href;
}

// Skip automatic image rendering when hidden (author places it manually).
const showImage = image && !image.hidden;

// Percentage-sized images float, so they must live inside the prose
// flow context for text to wrap around them.
const imageFloats = showImage && /^\d+%$/.test(image.size);

// Sorted posts for prev/next navigation
const allPosts = await getCollection("blog");
allPosts.sort(compareBlogPostsAsc);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<BlogLayout
  title={`${title} - Jim Myhrberg`}
  description={description}
  ogType="article"
  publishedTime={date}
  modifiedTime={updatedDate}
  tags={tags}
  ogImage={ogImageUrl}
>
  <article>
    <header>
      <PageHeading as="h1" size="post" uppercase>{title}</PageHeading>
      {
        description && (
          <p class="text-subheading mt-2 text-lg leading-snug">{description}</p>
        )
      }
      <div class="mt-4">
        <PostMeta
          date={date}
          updatedDate={updatedDate}
          readingTime={readTime}
        />
      </div>
      <hr class="border-border mt-6" />
    </header>

    {
      showImage && !imageFloats && (
        <Image
          src={image.src}
          alt={image.alt}
          caption={image.caption}
          credit={image.credit}
          size={image.size}
          position={image.position}
          aspect={image.aspect}
          objectPosition={image.objectPosition}
          flush={image.flush}
          noLightbox={image.noLightbox ?? true}
          gallery={image.gallery}
        />
      )
    }

    <div class="prose dark:prose-invert mt-8">
      {
        showImage && imageFloats && (
          <Image
            src={image.src}
            alt={image.alt}
            caption={image.caption}
            credit={image.credit}
            size={image.size}
            position={image.position}
            aspect={image.aspect}
            objectPosition={image.objectPosition}
            flush={image.flush}
            noLightbox={image.noLightbox ?? true}
            gallery={image.gallery}
          />
        )
      }
      <Content />
    </div>
    <FancyboxInit />
    <CodeCopyButton />
  </article>

  {
    tags && tags.length > 0 && (
      <div class="mt-10">
        <TagList tags={tags} />
      </div>
    )
  }

  <hr class="border-border mt-8" />

  <nav
    class="mt-6 flex justify-between gap-4 text-sm"
    aria-label="Post navigation"
  >
    {
      prevPost ? (
        <PostPagerLink
          href={`/blog/${prevPost.id}/`}
          label="Previous"
          title={prevPost.data.title}
        />
      ) : (
        <div />
      )
    }
    {
      nextPost ? (
        <PostPagerLink
          href={`/blog/${nextPost.id}/`}
          label="Next"
          title={nextPost.data.title}
          align="right"
        />
      ) : (
        <div />
      )
    }
  </nav>
</BlogLayout>
