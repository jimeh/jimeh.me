---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { Image } from "@mdx/index";
import PostMeta from "@components/blog/PostMeta.astro";
import FancyboxInit from "@components/blog/FancyboxInit.astro";
import { readingTime } from "@utils/reading-time";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, date, updatedDate, tags, image } = post.data;
const readTime = readingTime(post.body ?? "");
const { Content } = await render(post);

// Resolve absolute URL for OG/Twitter image meta tags.
let ogImageUrl: string | undefined;
if (image) {
  const optimized = await getImage({
    src: image.src,
    width: 1200,
    format: "jpg",
  });
  ogImageUrl = new URL(optimized.src, Astro.site).href;
}

// Skip automatic image rendering when hidden (author places it manually).
const showImage = image && !image.hidden;

// Percentage-sized images float, so they must live inside the prose
// flow context for text to wrap around them.
const imageFloats = showImage && /^\d+%$/.test(image.size);

// Sorted posts for prev/next navigation
const allPosts = await getCollection("blog");
allPosts.sort(
  (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<BlogLayout
  title={`${title} - Jim Myhrberg`}
  description={description}
  ogType="article"
  publishedTime={date}
  modifiedTime={updatedDate}
  tags={tags}
  ogImage={ogImageUrl}
>
  <article>
    <header>
      <h1
        class="text-heading text-3xl leading-tight font-bold uppercase [font-stretch:75%] sm:text-4xl"
      >
        {title}
      </h1>
      {
        description && (
          <p class="text-subheading mt-2 text-lg leading-snug italic">
            {description}
          </p>
        )
      }
      <div class="mt-4">
        <PostMeta
          date={date}
          updatedDate={updatedDate}
          readingTime={readTime}
          tags={tags}
        />
      </div>
      <hr class="border-border mt-6" />
    </header>

    {
      showImage && !imageFloats && (
        <Image
          src={image.src}
          alt={image.alt}
          caption={image.caption}
          credit={image.credit}
          size={image.size}
          position={image.position}
          aspect={image.aspect}
          objectPosition={image.objectPosition}
          flush={image.flush}
          noLightbox={image.noLightbox ?? true}
          gallery={image.gallery}
        />
      )
    }

    <div class="prose mt-8">
      {
        showImage && imageFloats && (
          <Image
            src={image.src}
            alt={image.alt}
            caption={image.caption}
            credit={image.credit}
            size={image.size}
            position={image.position}
            aspect={image.aspect}
            objectPosition={image.objectPosition}
            flush={image.flush}
            noLightbox={image.noLightbox ?? true}
            gallery={image.gallery}
          />
        )
      }
      <Content />
    </div>
    <FancyboxInit />
  </article>

  <hr class="border-border mt-12" />

  <nav
    class="mt-6 flex justify-between gap-4 text-sm"
    aria-label="Post navigation"
  >
    {
      prevPost ? (
        <a
          href={`/blog/${prevPost.id}/`}
          class="text-muted hover:text-accent flex-1 transition-colors"
        >
          <span class="text-xs tracking-wide uppercase">Previous</span>
          <span class="mt-0.5 block leading-snug font-bold [font-stretch:75%]">
            {prevPost.data.title}
          </span>
        </a>
      ) : (
        <div />
      )
    }
    {
      nextPost ? (
        <a
          href={`/blog/${nextPost.id}/`}
          class="text-muted hover:text-accent flex-1 text-right transition-colors"
        >
          <span class="text-xs tracking-wide uppercase">Next</span>
          <span class="mt-0.5 block leading-snug font-bold [font-stretch:75%]">
            {nextPost.data.title}
          </span>
        </a>
      ) : (
        <div />
      )
    }
  </nav>
</BlogLayout>
