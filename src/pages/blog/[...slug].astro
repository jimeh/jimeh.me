---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import { Code } from "astro:components";
import { Icon } from "astro-icon/components";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { Image } from "@mdx/index";
import PostPagerLink from "@components/blog/PostPagerLink.astro";
import PostMeta from "@components/blog/PostMeta.astro";
import TagList from "@components/blog/TagList.astro";
import CodeCopyButton from "@components/blog/CodeCopyButton.astro";
import FancyboxInit from "@components/blog/FancyboxInit.astro";
import PageHeading from "@components/ui/PageHeading.astro";
import Tooltip from "@components/ui/Tooltip.astro";
import { blogArchiveInfo } from "@utils/blog-archive";
import {
  blogArchiveTagsUrl,
  blogArchivesUrl,
  blogIndexUrl,
  blogNamedArchiveTagsUrl,
  blogPostMarkdownUrl,
  blogPostUrl,
  blogTagsUrl,
} from "@utils/blog-url";
import { darkImage, lightImage } from "@utils/image-source";
import { blogPostMarkdown } from "@utils/markdown-export";
import { resolveBlogMarkdownAsset } from "@utils/markdown-assets";
import { postImageNoLightbox } from "@utils/post-image-lightbox";
import { readingTime } from "@utils/reading-time";
import { blogPostStaticPaths, postPageNavigation } from "@utils/blog-page-data";

export async function getStaticPaths() {
  return blogPostStaticPaths(await getCollection("blog"));
}

const { post } = Astro.props;
const { title, description, date, updatedDate, tags, image } = post.data;
const archive = blogArchiveInfo(post);
const breadcrumbs = [
  { href: "/", label: "jimeh" },
  { href: blogIndexUrl(), label: "Blog" },
];
if (archive) {
  breadcrumbs.push({ href: blogArchivesUrl(), label: "Archives" });
  if (!archive.isGeneral) {
    breadcrumbs.push({ href: archive.url, label: archive.label });
  }
}
const archiveMetaLabel = archive
  ? archive.isGeneral
    ? "archive"
    : `${archive.label} archive`
  : undefined;
const tagBaseUrl = archive
  ? archive.isGeneral
    ? blogArchiveTagsUrl()
    : blogNamedArchiveTagsUrl(archive.slug)
  : blogTagsUrl();
const readTime = readingTime(post.body ?? "");
const { Content } = await render(post);
const imageLight = image ? lightImage(image.src) : undefined;
const imageDark = image ? darkImage(image.src) : undefined;
const noImageLightbox = postImageNoLightbox(image?.noLightbox);

// Resolve absolute URL for OG/Twitter image meta tags.
let ogImageUrl: string | undefined;
if (imageLight) {
  if (imageLight.format === "svg") {
    ogImageUrl = new URL(imageLight.src, Astro.site).href;
  } else {
    const optimized = await getImage({
      src: imageLight,
      width: 1200,
      format: "jpg",
    });
    ogImageUrl = new URL(optimized.src, Astro.site).href;
  }
}

// Skip automatic image rendering when hidden (author places it manually).
const showImage = image && !image.hidden;

// Percentage-sized images float, so they must live inside the prose
// flow context for text to wrap around them.
const imageFloats = showImage && /^\d+(?:\.\d+)?%$/.test(image.size);

// Sorted posts for prev/next navigation
const { prevPost, nextPost } = postPageNavigation(
  await getCollection("blog"),
  post,
);
const markdownTooltipId = `post-markdown-tooltip-${crypto.randomUUID()}`;
const markdownUrl = blogPostMarkdownUrl(post);
const postMarkdown = await blogPostMarkdown(post, {
  resolveAsset: resolveBlogMarkdownAsset,
});
const markdownFilename = `${post.data.slug}.md`;
---

<BlogLayout
  title={`${title} - Jim Myhrberg`}
  description={description}
  ogType="article"
  publishedTime={date}
  modifiedTime={updatedDate}
  tags={tags}
  ogImage={ogImageUrl}
  breadcrumbs={breadcrumbs}
>
  <article>
    <header>
      <PageHeading as="h1" size="post" uppercase>{title}</PageHeading>
      {
        description && (
          <p class="text-subheading mt-2 text-lg leading-snug">{description}</p>
        )
      }
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <PostMeta
          date={date}
          updatedDate={updatedDate}
          readingTime={readTime}
          archiveLabel={archiveMetaLabel}
          archiveHref={archive?.url}
        />
        <Tooltip id={markdownTooltipId} layer="content" placement="bottom">
          <button
            slot="trigger"
            type="button"
            data-post-markdown-toggle
            class="text-muted hover:text-accent border-border hover:border-accent focus-visible:outline-accent aria-pressed:border-accent aria-pressed:text-accent inline-flex cursor-pointer rounded-full border p-2 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 aria-pressed:bg-[oklch(from_var(--accent)_l_c_h_/_12%)]"
            aria-label="Markdown view"
            aria-describedby={markdownTooltipId}
            aria-pressed="false"
          >
            <Icon name="octicon:markdown-16" class="size-4" />
          </button>
          <span>Show Markdown</span>
        </Tooltip>
      </div>
      <hr class="border-border mt-6" />
    </header>

    <span
      class="pointer-events-none absolute size-0 overflow-hidden"
      aria-hidden="true"
    >
      <Icon name="octicon:copy-16" class="size-4" />
      <Icon name="octicon:check-16" class="size-4" />
    </span>

    <div data-post-html-view>
      {
        showImage && imageLight && !imageFloats && (
          <Image
            src={imageLight}
            alt={image.alt}
            caption={image.caption}
            credit={image.credit}
            size={image.size}
            position={image.position}
            aspect={image.aspect}
            objectPosition={image.objectPosition}
            flush={image.flush}
            noLightbox={noImageLightbox}
            gallery={image.gallery}
            darkSrc={imageDark}
            loading="eager"
          />
        )
      }

      <div
        class="prose dark:prose-invert mt-8 max-w-none after:clear-both after:block"
      >
        {
          showImage && imageLight && imageFloats && (
            <Image
              src={imageLight}
              alt={image.alt}
              caption={image.caption}
              credit={image.credit}
              size={image.size}
              position={image.position}
              aspect={image.aspect}
              objectPosition={image.objectPosition}
              flush={image.flush}
              noLightbox={noImageLightbox}
              gallery={image.gallery}
              darkSrc={imageDark}
              loading="eager"
            />
          )
        }
        <Content />
      </div>
      <FancyboxInit />
      <CodeCopyButton />
    </div>

    <section
      id="markdown"
      data-post-markdown-view
      class="mt-8 hidden"
      aria-label="Markdown source"
    >
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <p class="text-muted inline-flex items-center gap-1.5 text-sm">
          <Icon name="octicon:markdown-16" class="size-4" aria-hidden="true" />
          <span>Markdown source</span>
        </p>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            data-post-markdown-copy
            class="text-muted hover:text-accent border-border hover:border-accent focus-visible:outline-accent inline-flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <Icon
              name="octicon:copy-16"
              class="size-4"
              data-post-markdown-copy-icon="copy"
            />
            <Icon
              name="octicon:check-16"
              class="hidden size-4 text-(--alert-tip)"
              data-post-markdown-copy-icon="copied"
            />
            <span data-post-markdown-copy-label="copy">Copy</span>
            <span data-post-markdown-copy-label="copied" class="hidden">
              Copied
            </span>
          </button>
          <a
            href={markdownUrl}
            data-post-markdown-download
            download={markdownFilename}
            class="text-muted hover:text-accent border-border hover:border-accent focus-visible:outline-accent inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <Icon name="heroicons:arrow-down-tray" class="size-4" />
            <span>Download</span>
          </a>
          <a
            href={markdownUrl}
            data-post-markdown-raw
            class="text-muted hover:text-accent border-border hover:border-accent focus-visible:outline-accent inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            <Icon name="octicon:file-code-16" class="size-4" />
            <span>Raw</span>
          </a>
        </div>
      </div>
      <div class="prose dark:prose-invert max-w-none">
        <div data-rehype-pretty-code-figure data-post-markdown-code>
          <Code
            code={postMarkdown}
            lang="markdown"
            themes={{ light: "one-light", dark: "one-dark-pro" }}
            defaultColor={false}
            wrap={false}
          />
        </div>
      </div>
    </section>
  </article>

  <div data-post-html-view>
    {
      tags && tags.length > 0 && (
        <div class="mt-10">
          <TagList tags={tags} tagBaseUrl={tagBaseUrl} />
        </div>
      )
    }

    <hr class="border-border mt-8" />

    <nav
      class="mt-6 flex justify-between gap-4 text-sm"
      aria-label="Post navigation"
    >
      {
        prevPost ? (
          <PostPagerLink
            href={blogPostUrl(prevPost)}
            label="Previous"
            title={prevPost.data.title}
          />
        ) : (
          <div />
        )
      }
      {
        nextPost ? (
          <PostPagerLink
            href={blogPostUrl(nextPost)}
            label="Next"
            title={nextPost.data.title}
            align="right"
          />
        ) : (
          <div />
        )
      }
    </nav>
  </div>
</BlogLayout>

<script>
  import { initPostMarkdownView } from "@components/blog/post-markdown-view";

  function init() {
    initPostMarkdownView(document, navigator.clipboard);
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
</script>
