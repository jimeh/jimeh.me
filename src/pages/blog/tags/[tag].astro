---
import { getCollection } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import PostCard from "@components/blog/PostCard.astro";
import MetaText from "@components/ui/MetaText.astro";
import PageHeading from "@components/ui/PageHeading.astro";
import { blogTagPosts, blogTagStaticPaths } from "@utils/blog-page-data";
import { blogTagsUrl } from "@utils/blog-url";

export async function getStaticPaths() {
  return blogTagStaticPaths(await getCollection("blog"));
}

const { tag } = Astro.props;
const posts = blogTagPosts(await getCollection("blog"), tag);
---

<BlogLayout
  title={`"${tag}" posts - Blog - Jim Myhrberg`}
  description={`Blog posts tagged "${tag}"`}
>
  <PageHeading as="h1" size="page" uppercase>{tag}</PageHeading>
  <MetaText>
    {posts.length}{" "}
    {posts.length === 1 ? "post" : "posts"}
    &middot;
    <a href={blogTagsUrl()} class="text-accent hover:underline"> all tags </a>
  </MetaText>

  <div class="mt-8 space-y-8">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BlogLayout>
