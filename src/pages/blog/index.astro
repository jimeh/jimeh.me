---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostCard from "@components/blog/PostCard.astro";
import PostFeatured from "@components/blog/PostFeatured.astro";
import MetaText from "@components/ui/MetaText.astro";
import PageHeading from "@components/ui/PageHeading.astro";
import { siteConfig } from "../../data/site";
import {
  blogArchiveInfo,
  isArchivedPost,
  isMainBlogPost,
} from "@utils/blog-archive";
import { compareBlogPostsDesc } from "@utils/blog-sort";
import { blogPostYear } from "@utils/blog-url";

const allPosts = await getCollection("blog");
const posts = allPosts.filter(isMainBlogPost);
const archivePosts = allPosts.filter(isArchivedPost);

// Sort newest first
posts.sort(compareBlogPostsDesc);
archivePosts.sort(compareBlogPostsDesc);

// Featured post = newest
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
const eagerThumbnailCount = 6;
const eagerThumbnailIds = new Set(
  remainingPosts.slice(0, eagerThumbnailCount).map((post) => post.id),
);

// Group remaining by year
const postsByYear = new Map<string, typeof remainingPosts>();
for (const post of remainingPosts) {
  const year = blogPostYear(post);
  if (!postsByYear.has(year)) {
    postsByYear.set(year, []);
  }
  postsByYear.get(year)!.push(post);
}

const years = [...postsByYear.keys()].sort((a, b) => b.localeCompare(a));
const archiveNames = [];
if (archivePosts.some((post) => blogArchiveInfo(post)?.isGeneral)) {
  archiveNames.push(new URL(siteConfig.url).hostname);
}
archiveNames.push(
  ...new Set(
    archivePosts
      .map((post) => blogArchiveInfo(post))
      .filter((archive) => archive && !archive.isGeneral)
      .map((archive) => archive!.label),
  ),
);
const archiveSummary =
  archiveNames.length > 0
    ? `${archivePosts.length} older posts from ${archiveNames.join(", ")}`
    : `${archivePosts.length} older posts`;
---

<BlogLayout
  title="Blog - Jim Myhrberg"
  description="Blog posts by Jim Myhrberg"
>
  <PageHeading as="h1" size="page" uppercase>Blog</PageHeading>
  <MetaText>{posts.length} posts</MetaText>

  {
    featuredPost && (
      <section class="mt-8" aria-label="Latest post">
        <PostFeatured post={featuredPost} />
      </section>
    )
  }

  {
    years.map((year) => (
      <section class="mt-12">
        <PageHeading as="h2" size="section" class="text-muted mb-6 opacity-75">
          <a
            href={`/blog/${year}/`}
            class="hover:text-accent transition-colors"
          >
            {year}
          </a>
        </PageHeading>
        <div class="space-y-6">
          {postsByYear.get(year)!.map((post) => (
            <PostCard
              post={post}
              imageLoading={eagerThumbnailIds.has(post.id) ? "eager" : "lazy"}
            />
          ))}
        </div>
      </section>
    ))
  }

  {
    archivePosts.length > 0 && (
      <nav class="border-border mt-14 border-t pt-6" aria-label="Archives">
        <a href="/blog/archives/" class="group inline-block">
          <span class="text-heading group-hover:text-accent block text-lg font-bold [font-stretch:75%] transition-colors">
            Archives
          </span>
          <span class="text-muted mt-1 block text-sm">{archiveSummary}</span>
        </a>
      </nav>
    )
  }
</BlogLayout>
