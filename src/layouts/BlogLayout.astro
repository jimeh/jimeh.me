---
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  ogImage?: string;
}

const { ...props } = Astro.props;
---

<BaseLayout {...props}>
  <Fragment slot="header-nav">
    <a
      href="/"
      class="text-heading hover:text-accent text-sm font-bold tracking-wide uppercase [font-stretch:75%] transition-colors"
    >
      jimeh
    </a>
    <Icon
      name="heroicons:chevron-right"
      class="text-muted mx-1.5 size-2.5 opacity-50"
    />
    <a
      href="/blog/"
      class="text-heading hover:text-accent text-sm font-bold tracking-wide uppercase [font-stretch:75%] transition-colors"
    >
      Blog
    </a>
  </Fragment>

  <div class="mx-auto max-w-2xl px-6 pt-16 pb-12">
    <main>
      <slot />
    </main>
  </div>
</BaseLayout>
