---
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";
import NavTextLink from "@components/ui/NavTextLink.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  ogImage?: string;
}

const { ...props } = Astro.props;
---

<BaseLayout {...props}>
  <Fragment slot="header-nav">
    <NavTextLink href="/">jimeh</NavTextLink>
    <Icon name="heroicons:chevron-right" class="text-muted mx-1.5 size-2.5" />
    <NavTextLink href="/blog/">Blog</NavTextLink>
  </Fragment>

  <div class="mx-auto max-w-2xl px-6 pt-16 pb-12">
    <main>
      <slot />
    </main>
  </div>
</BaseLayout>
