---
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  ogImage?: string;
  wide?: boolean;
}

const { wide = false, ...props } = Astro.props;
---

<BaseLayout {...props}>
  <Fragment slot="header-nav">
    <a
      href="/"
      class="text-muted hover:text-accent flex items-center gap-1.5 text-sm font-bold uppercase [font-stretch:75%] transition-colors"
    >
      <Icon name="heroicons:arrow-left" class="size-3.5" />
      jimeh.me
    </a>
    <span class="text-heading-muted mx-2 select-none">/</span>
    <a
      href="/blog/"
      class="text-heading hover:text-accent text-sm font-bold uppercase [font-stretch:75%] transition-colors"
    >
      Blog
    </a>
  </Fragment>

  <div
    class:list={["mx-auto px-6 pt-16 pb-12", wide ? "max-w-3xl" : "max-w-2xl"]}
  >
    <main>
      <slot />
    </main>
  </div>
</BaseLayout>
