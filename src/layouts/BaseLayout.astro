---
import "../styles/main.css";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { Font } from "astro:assets";
import SEOHead from "../components/SEOHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteConfig } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}

/** Short content hash for cache busting a public/ asset. */
function fileHash(path: string): string {
  const data = readFileSync(new URL(path, import.meta.url));
  return createHash("sha256")
    .update(new Uint8Array(data))
    .digest("hex")
    .slice(0, 8);
}

const { title, description, ogType, publishedTime, modifiedTime, tags } =
  Astro.props;
const pageTitle = title || siteConfig.title;
const hasHeaderNav = Astro.slots.has("header-nav");
const faviconHash = fileHash("../../public/favicon.ico");
const appleTouchHash = fileHash("../../public/apple-touch-icon.png");
---

<!doctype html>
<html class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>

    <SEOHead
      title={pageTitle}
      description={description}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />
    <Font cssVariable="--font-open-sans" preload />
    <link rel="icon" href={`/favicon.ico?v=${faviconHash}`} />
    <link
      rel="apple-touch-icon"
      href={`/apple-touch-icon.png?v=${appleTouchHash}`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Jim Myhrberg's Blog"
      href="/rss.xml"
    />
    <script is:inline>
      (function () {
        let t = null;
        try {
          t = localStorage.getItem("theme");
        } catch {
          /* localStorage unavailable */
        }
        const d =
          t === "dark" ||
          (t !== "light" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (d) document.documentElement.classList.add("dark");
      })();
    </script>
  </head>
  <body
    class:list={[
      "text-on-surface h-full font-sans text-sm leading-normal",
      "bg-surface",
    ]}
  >
    <SiteHeader hasNav={hasHeaderNav}>
      <slot name="header-nav" />
    </SiteHeader>
    <slot />
  </body>
</html>
